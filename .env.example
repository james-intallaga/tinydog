# tinydog.ai is private and local by default. The portable launcher sets the
# actual backend after inspecting this computer.
TINYDOG_BACKEND=auto
# Run `tinydog model` to choose 20m, 50m, 80m, 100m, 200m, or 300m
# without editing this file. Auto uses 20m on a fresh installation.
TINYDOG_MODEL_SIZE=auto

# Default: every five distinct eligible typed turns run one private, complete
# foundation update. All artifacts and conversations remain on this computer.
# Replay is bounded to eight older targets, bundle publication has an 8 GiB
# safety ceiling, and a failed run waits five minutes before retrying.
MLM_PERSONAL_LEARNING_MODE=foundation
MLM_PERSONAL_FOUNDATION_AUTO=1
MLM_PERSONAL_FOUNDATION_DIR=data/personal-foundations
MLM_PERSONAL_FOUNDATION_MAX_REPLAY_EXAMPLES=8
MLM_PERSONAL_FOUNDATION_MAX_BUNDLE_BYTES=8589934592
MLM_PERSONAL_FOUNDATION_FAILURE_BACKOFF_SECONDS=300

# Legacy v1 adapter compatibility only. These settings are ignored in the
# default foundation mode. Set MLM_PERSONAL_LEARNING_MODE=adapter explicitly
# to use old adapters; they remain separate and cannot be merged into v2
# personal-foundation checkpoints.
MLM_PERSONAL_TRAINING_AUTO=1
MLM_PERSONAL_MODEL_DIR=data/personal-model
MLM_PERSONAL_MIN_HOLDOUT_IMPROVEMENT=0
MLM_PERSONAL_MAX_REPLAY_EXAMPLES=8
MLM_PERSONAL_RETENTION_EXAMPLES=2
MLM_PERSONAL_MAX_RETENTION_LOSS_INCREASE=0.05
MLM_PERSONAL_MAX_ADAPTER_BYTES=536870912

# Optional native realtime checkpoint for the Apple-Silicon MLX research path.
# Leave empty until a locally trained checkpoint passes all native quality gates.
MLM_NATIVE_CHECKPOINT=

# Optional diagnostic on Apple Silicon: expose the native model's own random,
# unintelligible audio. This is not a trained voice and is not language learning.
MLM_UNTRAINED_NATIVE_CONFIG=
MLM_UNTRAINED_NATIVE_SEED=0

# The old arithmetic/community experiments use separate settings in
# `configs/legacy-research.env.example`. They are never selected by the normal
# personal launcher.
