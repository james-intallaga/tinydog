# Research-only settings for `tinydog start --legacy-mlx` and the older
# arithmetic/community experiments. These are not read by the default portable
# personal learner. Copy only the values you deliberately need into `.env`.

MLM_TRAINING_AUTHORITY=community
MLM_AUTO_TRAIN_LESSONS=32
MLM_CANDIDATE_STEPS=20
MLM_TRAIN_BATCH_SIZE=1
MLM_TRAIN_CONTEXT=256
MLM_EVALUATION_BATCHES=3
MLM_MIN_NEW_LOSS_IMPROVEMENT=0.0001
MLM_CHECKPOINT_RETENTION=3
